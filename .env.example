# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# AUTH_TOKEN_SECRET: Required in production (>= 32 characters) for HMAC-SHA256 session signing.
# In local dev/test, if unset, an ephemeral random 32-byte key is generated per server boot.
AUTH_TOKEN_SECRET="replace-with-at-least-32-bytes-of-cryptographic-entropy-in-prod"

# ENABLE_DEMO_IMPERSONATION: Set to "true" ONLY in development/demo environments to enable
# one-click persona switching (/api/v1/auth/demo-switch). Must be "false" in production.
ENABLE_DEMO_IMPERSONATION="true"

# PAYPAL_CLIENT_ID & PAYPAL_CLIENT_SECRET: Server-side PayPal Developer Sandbox credentials.
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_ENV="sandbox"

# GITHUB_TOKEN: Optional personal access token for higher rate limits on GitHub commit lookups.
GITHUB_TOKEN=""

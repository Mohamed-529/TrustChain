{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://milestoneproof.ai/schemas/phase9-agent-output-schemas.json",
  "title": "MilestoneProof AI Phase 9 Structured Agent Output Schemas",
  "description": "Defines rigid JSON output schemas for EvidenceAgent, RiskAgent, ArbitratorAgent, and PolicyCalculationResult, with strict financial authority boundaries.",
  "$defs": {
    "CriterionVerificationResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criterionId", "status", "confidence", "evidenceCitations", "explanation"],
      "properties": {
        "criterionId": { "type": "string", "pattern": "^crit_[a-zA-Z0-9_-]+$" },
        "status": {
          "type": "string",
          "enum": ["VERIFIED", "PARTIAL", "UNVERIFIED", "CONTRADICTED"]
        },
        "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "evidenceCitations": {
          "type": "array",
          "items": { "type": "string", "pattern": "^ev_[a-zA-Z0-9_-]+$" }
        },
        "explanation": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    },
    "EvidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceId", "sourceType", "label", "excerpt"],
      "properties": {
        "evidenceId": { "type": "string", "pattern": "^ev_[a-zA-Z0-9_-]+$" },
        "sourceType": {
          "type": "string",
          "enum": ["COMMIT", "PULL_REQUEST", "CI_REPORT", "SECURITY_SCAN"]
        },
        "label": { "type": "string", "minLength": 1, "maxLength": 200 },
        "verifiedUrl": { "type": "string", "format": "uri" },
        "excerpt": { "type": "string", "maxLength": 1000 }
      }
    },
    "SecurityFindingItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "packageName", "severity", "cvssScore", "description"],
      "properties": {
        "id": { "type": "string" },
        "packageName": { "type": "string" },
        "severity": { "type": "string", "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"] },
        "cvssScore": { "type": "number", "minimum": 0.0, "maximum": 10.0 },
        "description": { "type": "string" }
      }
    },
    "EvidenceAnalysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agentName",
        "model",
        "isMock",
        "criteriaResults",
        "verifiedCount",
        "totalCount",
        "missingEvidence",
        "factualObservations",
        "evidenceReferences"
      ],
      "properties": {
        "agentName": { "type": "string", "const": "EvidenceAgent" },
        "model": { "type": "string" },
        "isMock": { "type": "boolean" },
        "criteriaResults": {
          "type": "array",
          "items": { "$ref": "#/$defs/CriterionVerificationResult" },
          "minItems": 1
        },
        "verifiedCount": { "type": "integer", "minimum": 0 },
        "totalCount": { "type": "integer", "minimum": 1 },
        "missingEvidence": { "type": "array", "items": { "type": "string" } },
        "factualObservations": { "type": "array", "items": { "type": "string" } },
        "evidenceReferences": {
          "type": "array",
          "items": { "$ref": "#/$defs/EvidenceReference" }
        }
      }
    },
    "RiskAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agentName",
        "model",
        "isMock",
        "scannerStatus",
        "overallRiskSeverity",
        "criticalVulnCount",
        "highVulnCount",
        "ciBuildPassed",
        "findings",
        "suspiciousSignals",
        "contradictions",
        "missingTestSignals",
        "promptInjectionDetected",
        "promptInjectionIndicators",
        "summary"
      ],
      "properties": {
        "agentName": { "type": "string", "const": "RiskAgent" },
        "model": { "type": "string" },
        "isMock": { "type": "boolean" },
        "scannerStatus": { "type": "string", "enum": ["AVAILABLE", "UNAVAILABLE"] },
        "overallRiskSeverity": {
          "type": "string",
          "enum": ["NONE", "LOW", "MEDIUM", "HIGH", "CRITICAL"]
        },
        "criticalVulnCount": { "type": "integer", "minimum": 0 },
        "highVulnCount": { "type": "integer", "minimum": 0 },
        "ciBuildPassed": { "type": "boolean" },
        "findings": {
          "type": "array",
          "items": { "$ref": "#/$defs/SecurityFindingItem" }
        },
        "suspiciousSignals": { "type": "array", "items": { "type": "string" } },
        "contradictions": { "type": "array", "items": { "type": "string" } },
        "missingTestSignals": { "type": "array", "items": { "type": "string" } },
        "promptInjectionDetected": { "type": "boolean" },
        "promptInjectionIndicators": { "type": "array", "items": { "type": "string" } },
        "summary": { "type": "string" }
      }
    },
    "HumanReviewRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "reviewType", "notes"],
      "properties": {
        "required": { "type": "boolean", "const": true },
        "reviewType": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "ReviewSynthesis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agentName",
        "model",
        "isMock",
        "recommendedOutcome",
        "recommendation",
        "confidenceLevel",
        "confidenceScore",
        "evidenceReferences",
        "reasoningSummary",
        "missingInformation",
        "riskFlags",
        "humanReviewRequirement",
        "disagreements",
        "rationale",
        "advisoryNotice",
        "isAdvisoryOnly"
      ],
      "properties": {
        "agentName": { "type": "string", "const": "ArbitratorAgent" },
        "model": { "type": "string" },
        "isMock": { "type": "boolean" },
        "recommendedOutcome": {
          "type": "string",
          "enum": ["PASS", "FAIL", "NEEDS_HUMAN_REVIEW"]
        },
        "recommendation": {
          "type": "string",
          "enum": ["RECOMMEND_APPROVAL", "RECOMMEND_HOLD", "RECOMMEND_REJECTION"]
        },
        "confidenceLevel": {
          "type": "string",
          "enum": ["HIGH", "MEDIUM", "LOW"]
        },
        "confidenceScore": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "evidenceReferences": { "type": "array", "items": { "type": "string" } },
        "reasoningSummary": { "type": "string", "minLength": 10 },
        "missingInformation": { "type": "array", "items": { "type": "string" } },
        "riskFlags": { "type": "array", "items": { "type": "string" } },
        "humanReviewRequirement": { "$ref": "#/$defs/HumanReviewRequirement" },
        "disagreements": { "type": "array", "items": { "type": "string" } },
        "rationale": { "type": "string" },
        "advisoryNotice": {
          "type": "string",
          "pattern": "^ADVISORY ONLY.*Deterministic Settlement Policy Engine and Human Reviewer remain authoritative.*$"
        },
        "isAdvisoryOnly": { "type": "boolean", "const": true }
      }
    },
    "PolicyCalculationResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engineVersion",
        "agreedAmountCents",
        "verifiedCriteriaRatio",
        "gatesTripped",
        "gateBlocked",
        "lateDays",
        "latePenaltyCents",
        "permittedAmountCents",
        "currency",
        "formulaExplanation"
      ],
      "properties": {
        "engineVersion": { "type": "string" },
        "agreedAmountCents": { "type": "integer", "minimum": 0 },
        "verifiedCriteriaRatio": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "grossEligibleCents": { "type": "integer", "minimum": 0 },
        "deductionCents": { "type": "integer", "minimum": 0 },
        "gatesTripped": { "type": "array", "items": { "type": "string" } },
        "blockingReasons": { "type": "array", "items": { "type": "string" } },
        "gateBlocked": { "type": "boolean" },
        "lateDays": { "type": "integer", "minimum": 0 },
        "latePenaltyCents": { "type": "integer", "minimum": 0 },
        "permittedAmountCents": { "type": "integer", "minimum": 0 },
        "currency": { "type": "string", "const": "USD" },
        "formulaExplanation": { "type": "string" }
      }
    },
    "EvaluationRun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "milestoneId",
        "submissionId",
        "status",
        "evaluationMode",
        "isMockEvaluation",
        "evidenceAnalysis",
        "riskAnalysis",
        "arbitratorRecommendation",
        "policyCalculation",
        "evaluatedAt"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^eval_[a-zA-Z0-9_-]+$" },
        "milestoneId": { "type": "string", "pattern": "^ms_[a-zA-Z0-9_-]+$" },
        "submissionId": { "type": "string", "pattern": "^sub_[a-zA-Z0-9_-]+$" },
        "status": { "type": "string", "enum": ["RUNNING", "COMPLETED", "FAILED"] },
        "evaluationMode": { "type": "string", "enum": ["LIVE_GEMINI", "DETERMINISTIC_MOCK"] },
        "isMockEvaluation": { "type": "boolean" },
        "evidenceAnalysis": { "$ref": "#/$defs/EvidenceAnalysis" },
        "riskAnalysis": { "$ref": "#/$defs/RiskAssessment" },
        "arbitratorRecommendation": { "$ref": "#/$defs/ReviewSynthesis" },
        "policyCalculation": { "$ref": "#/$defs/PolicyCalculationResult" },
        "evaluatedAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "prohibitedAuthorityProperties": [
    "approvedAmountCents",
    "finalPayableAmountCents",
    "paypalOrderId",
    "paypalCaptureId",
    "milestoneStatus",
    "paymentStatus",
    "bypassHumanApproval"
  ]
}
